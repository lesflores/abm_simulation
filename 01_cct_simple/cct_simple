# =====================================================================
# cct_simple. Modelo mínimo de transferencias condicionadas (CCT)
# Umbral de decisión + credibilidad aprendida
# Modelo simple del curso de simulación basada en agentes
# =====================================================================

# =========================
# 0) Paquetes y semilla
# =========================
library(ABM)        # Simulation, eventos, contadores
library(ggplot2)    # Gráfico de resultados
set.seed(1)         # Semilla fija: todos obtienen la misma curva

# =========================
# 1) Parámetros del modelo
# =========================
N               <- 5000   # Número de hogares (1 agente = 1 hogar)
Tmax            <- 36     # Meses a simular
transfer_amount <- 600    # Monto nominal mensual del programa ($600)
delay_prob_base <- 0.30   # Probabilidad de que el pago llegue tarde (30%)
lambda_cred     <- 0.30   # Velocidad de aprendizaje de la credibilidad (0 = lento, 1 = muy rápido)

# Interruptor de la sesión
senal_publica <- FALSE    # FALSE = regla original: no asistir cuenta como retraso (señal 0)
                          # TRUE  = corrección: quien no asiste recibe la señal pública 1 - delay_prob_base

# =====================================
# 2) Crear simulación y estado inicial
# =====================================
# Estado principal de cada agente: "A" (asiste) o "N" (no asiste).
# Atributos que viajan con el agente:
#   - theta: umbral individual (lo mínimo que el hogar necesita esperar recibir para cumplir)
#   - cred:  credibilidad percibida de que el pago llegue a tiempo (0 a 1)

sim <- Simulation$new(N)   # Crea el mundo con N agentes (IDs 1..N)

for (i in 1:N) {
  theta <- rnorm(1, mean = 300, sd = 80)   # Umbral heterogéneo ~ Normal(300, 80)
  cred0 <- 1 - delay_prob_base             # Credibilidad inicial = 0.70
  sim$setState(i, list("N", theta = theta, cred = cred0))
}
# setState(i, lista): el primer elemento SIEMPRE es el estado; el resto son atributos con nombre.
# Todos empiezan en "N": nadie ha decidido todavía.

# ======================================
# 3) Loggers (contadores automáticos)
# ======================================
sim$addLogger(newCounter("A", "A"))   # Cuántos asisten en cada mes
sim$addLogger(newCounter("N", "N"))   # Cuántos no asisten en cada mes

# =========================================================
# 4) Regla mensual: leer -> decidir -> señal -> escribir
# =========================================================
# Firma fija de ABM: function(time, sim, agent)
tick_handler <- function(time, sim, agent) {
  for (i in 1:N) {
    # --- Leer ---
    ai <- getAgent(sim, i)
    st <- getState(ai)               # st[[1]] es "A"/"N"; st$theta, st$cred

    # --- Decidir ---
    benefit   <- transfer_amount * st$cred           # Beneficio esperado: monto x credibilidad
    new_state <- if (benefit >= st$theta) "A" else "N"

    # --- Señal que recibe el hogar este mes ---
    if (new_state == "A") {
      # Asistió: observa su propio pago (puntual con prob. 1 - delay_prob_base)
      senal <- as.numeric(runif(1) > delay_prob_base)
    } else if (senal_publica) {
      # No asistió (corrección): no ve su pago, pero sabe cómo funciona el programa en su comunidad
      senal <- 1 - delay_prob_base
    } else {
      # No asistió (regla original): se registra como si el pago hubiera llegado tarde.
      # Así, quien sale ya no regresa: no asistir es un estado absorbente.
      senal <- 0
    }

    # Actualizar credibilidad (promedio móvil exponencial)
    cred_new <- (1 - lambda_cred) * st$cred + lambda_cred * senal

    # --- Escribir --- (setState reemplaza la ficha completa: hay que volver a escribir todos los atributos)
    setState(ai, list(new_state, theta = st$theta, cred = cred_new))
  }

  # Re-agendar la misma regla para el mes siguiente: esta línea hace avanzar el reloj
  if (time < Tmax) schedule(agent, newEvent(time + 1, tick_handler))
}

# ==============================
# 5) Ejecutar la simulación
# ==============================
schedule(sim$get, newEvent(0, tick_handler))   # Primer tick en t = 0
res <- sim$run(0:Tmax)                         # data.frame con columnas: times, A, N
res$attend <- res$A / N                        # Proporción que asiste
# Nota: el punto de times = 0 es el estado inicial, antes de la primera decisión.

# Guardar resultados en archivos CSV (se abren en Excel)
escenario <- if (senal_publica) "senal" else "original"

# 1) Todos los meses
write.csv(res, paste0("resultados_", escenario, ".csv"), row.names = FALSE)

# 2) Resumen: meses 1, 12 y 36
resumen <- data.frame(escenario  = escenario,
                      mes        = c(1, 12, 36),
                      asistencia = round(res$attend[match(c(1, 12, 36), res$times)], 3))
print(resumen)
write.csv(resumen, paste0("resumen_", escenario, ".csv"), row.names = FALSE)

# ==============================
# 6) Gráfico
# ==============================
titulo <- if (senal_publica) "CCT con señal pública" else "CCT, regla original"

p <- ggplot(res, aes(x = times, y = attend)) +
  geom_area(fill = "yellow2", alpha = 0.12) +
  geom_line(linewidth = 1.4, color = "orange", lineend = "round") +
  coord_cartesian(ylim = c(0, 1)) +
  labs(title = titulo, x = "Mes", y = "Proporción que asiste") +
  theme_minimal(base_size = 14)

p

# Guarda en PNG
ggsave(paste0("asistencia_", escenario, ".png"), plot = p, width = 8, height = 5, dpi = 300)
