# =====================================================================
# run_cct(). El modelo cct_simple envuelto en una función
# Cambien los argumentos, no el código de adentro.
# =====================================================================
library(ABM)

run_cct <- function(N = 2000, Tmax = 36, monto = 600, retraso = 0.30,
                    lambda = 0.30, senal_publica = FALSE, semilla = 1) {
  set.seed(semilla)
  sim <- Simulation$new(N)
  for (i in 1:N) {
    sim$setState(i, list("N", theta = rnorm(1, mean = 300, sd = 80), cred = 1 - retraso))
  }
  sim$addLogger(newCounter("A", "A"))
  sim$addLogger(newCounter("N", "N"))

  tick_handler <- function(time, sim, agent) {
    for (i in 1:N) {
      ai <- getAgent(sim, i)                      # Leer
      st <- getState(ai)
      new_state <- if (monto * st$cred >= st$theta) "A" else "N"   # Decidir
      if (new_state == "A") {
        senal <- as.numeric(runif(1) > retraso)   # Ve su propio pago
      } else if (senal_publica) {
        senal <- 1 - retraso                      # Lo que se sabe en la comunidad
      } else {
        senal <- 0                                # Regla original: no asistir = retraso
      }
      cred_new <- (1 - lambda) * st$cred + lambda * senal
      setState(ai, list(new_state, theta = st$theta, cred = cred_new))   # Escribir
    }
    if (time < Tmax) schedule(agent, newEvent(time + 1, tick_handler))
  }

  schedule(sim$get, newEvent(0, tick_handler))
  res <- sim$run(0:Tmax)
  res$attend <- res$A / N
  # Columnas que identifican el escenario (sirven para juntar corridas con bind_rows)
  res$monto <- monto; res$retraso <- retraso; res$lambda <- lambda
  res$senal_publica <- senal_publica; res$semilla <- semilla
  res
}

# ---------------------------------------------------------------------
# Ejemplo de uso
# ---------------------------------------------------------------------
a <- run_cct(senal_publica = FALSE)
b <- run_cct(senal_publica = TRUE)
a$attend[a$times == 12]            # asistencia en el mes 12

library(dplyr); library(ggplot2)
juntos <- bind_rows(a, b)
ggplot(juntos, aes(times, attend, colour = senal_publica)) +
   geom_line(linewidth = 1.2) + coord_cartesian(ylim = c(0, 1)) +
   labs(x = "Mes", y = "Proporción que asiste", colour = "Señal pública") +
   theme_minimal(base_size = 14)
