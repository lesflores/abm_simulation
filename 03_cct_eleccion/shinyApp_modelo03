)

# ---------------------------------------------------------------------
# 4) Lo que pasa cuando alguien mueve un control
# ---------------------------------------------------------------------
server <- function(input, output, session) {
  
  parametros <- reactive(list(
    monto = input$monto, tope = input$tope, linea = input$linea, bono = input$bono,
    soloE = input$soloE, delay = input$delay / 100, valor = input$valor,
    salario = input$salario, tau = input$tau))
  
  r <- reactive(simular(parametros()))
  
  output$pueblo <- renderUI({
    est <- r()$estados[input$mes + 1, ]
    puntos <- lapply(est, function(e) span(style = paste0("aspect-ratio:1;border-radius:50%;background:", colores[[e]])))
    leyenda <- lapply(names(nombres), function(op)
      span(style = "margin-right:14px", span(style = paste0("display:inline-block;width:11px;height:11px;border-radius:50%;margin-right:5px;background:", colores[[op]])), nombres[[op]]))
    tagList(
      div(style = "display:grid;grid-template-columns:repeat(20, 1fr);gap:4px;max-width:400px;margin:0 auto", puntos),
      div(style = "text-align:center;margin-top:10px;font-size:.9rem", leyenda)
    )
  })
  
  output$resultado <- renderUI({
    s  <- r()$shares; ti <- s[["ET"]] + s[["T"]]
    tb <- BASE$shares[["ET"]] + BASE$shares[["T"]]; ts <- SIN$shares[["ET"]] + SIN$shares[["T"]]
    tagList(
      h1(pct(ti), style = "font-size:3rem;margin:0"),
      p(strong("en trabajo infantil (estudia y trabaja + solo trabaja)")),
      p(class = "small", paste0("Programa actual: ", pct(tb), " · Sin programa: ", pct(ts),
                                " · Elegibles: ", pct(r()$elegibles))),
      p(paste0("Solo estudia ", pct(s[["E"]]), " · Estudia y trabaja ", pct(s[["ET"]]), " · Solo trabaja ", pct(s[["T"]])))
    )
  })
  
  output$barras <- renderUI({
    s <- r()$shares
    tramo <- function(op) div(style = paste0("width:", round(100 * s[[op]], 2), "%;background:", colores[[op]], ";height:100%"))
    div(style = "display:flex;height:28px;border-radius:8px;overflow:hidden;margin:6px 0 14px",
        tramo("E"), tramo("ET"), tramo("T"))
  })
  
  output$presupuesto <- renderUI({
    c0 <- r()$costo; dentro <- c0 <= PRESUP + 0.5
    p(strong(paste0("Costo: ", peso(c0), " al mes por hogar · Presupuesto: ", peso(PRESUP))), br(),
      span(if (dentro) "Dentro del presupuesto" else "Te pasaste del presupuesto",
           style = paste0("color:", if (dentro) colores[["E"]] else colores[["T"]], ";font-weight:bold")))
  })
  
  familia <- reactive({
    p <- parametros()
    transf <- if (input$f_eleg) (p$monto + if (input$f_edad >= 15) p$bono else 0) * min(input$f_hijos, p$tope) else 0
    beca <- transf * (1 - p$delay); w <- p$salario * exp(0.12 * (input$f_edad - 12))
    U <- c(E = beca + p$valor - input$f_theta,
           ET = (if (p$soloE) 0 else beca) + p$valor / 2 + w / 2 - input$f_theta,
           T = w)
    pr <- exp((U - max(U)) / p$tau); pr <- pr / sum(pr)
    list(beca = beca, w = w, U = U, pr = pr)
  })
  
  output$familia_texto <- renderUI({
    f <- familia()
    p(class = "small", paste0("Espera de beca: ", peso(f$beca), " · Aporte si trabaja: ", peso(f$w)))
  })
  
  output$familia <- renderUI({
    f <- familia()
    filas <- lapply(names(nombres), function(op) {
      div(style = "display:grid;grid-template-columns:9rem 1fr 7.5rem;gap:10px;align-items:center;margin-bottom:10px",
          span(nombres[[op]]),
          div(style = "height:18px;background:#2E2244;border-radius:6px;overflow:hidden",
              div(style = paste0("height:100%;width:", round(100 * f$pr[[op]], 1), "%;background:", colores[[op]]))),
          span(paste0(round(100 * f$pr[[op]]), "% (", round(f$U[[op]]), " pts)")))
    })
    div(style = "margin-top:8px", filas)
  })
  
  observeEvent(input$reset, {
    updateSliderInput(session, "monto", value = 300); updateSliderInput(session, "tope", value = 2)
    updateSliderInput(session, "linea", value = 4500); updateSliderInput(session, "bono", value = 0)
    updateCheckboxInput(session, "soloE", value = FALSE); updateSliderInput(session, "delay", value = 30)
    updateSliderInput(session, "valor", value = 1000); updateSliderInput(session, "salario", value = 300)
    updateSliderInput(session, "tau", value = 120)
  })
  
  disenos <- reactiveVal(data.frame())
  observeEvent(input$guardar, {
    p <- parametros(); s <- r()$shares
    fila <- data.frame(
      `Diseño` = if (nzchar(input$nombre)) input$nombre else paste("Diseño", nrow(disenos()) + 1),
      `Trabajo infantil` = pct(s[["ET"]] + s[["T"]]),
      Costo = peso(r()$costo),
      `Dentro del presupuesto` = if (r()$costo <= PRESUP + 0.5) "Sí" else "No",
      Reglas = paste0("Monto ", peso(p$monto), ", tope ", p$tope, ", línea ", peso(p$linea),
                      if (p$bono > 0) paste0(", bono 15-17 ", peso(p$bono)) else "",
                      if (p$soloE) ", solo sin trabajo" else "", ", retraso ", p$delay * 100, "%"),
      check.names = FALSE)
    disenos(rbind(disenos(), fila))
    updateTextInput(session, "nombre", value = "")
  })
  output$tabla <- renderTable(disenos())
  output$descargar <- downloadHandler(
    filename = function() "disenos_hackaton.csv",
    content  = function(file) write.csv(disenos(), file, row.names = FALSE))
}

shinyApp(ui, server)
